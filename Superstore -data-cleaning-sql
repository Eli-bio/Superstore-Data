WITH Duplicate_cte AS
(
SELECT*,
ROW_NUMBER() OVER(
PARTITION BY `Order ID`,`Order Date`,`Ship Date`,`Ship Mode`,`Customer Name`,Segment,Country,City,State,`Postal Code`,Region,`Product ID`,Category,
`Sub-Category`,`Product Name`,Sales,Quantity,Discount,Profit) AS row_num
FROM superstore_staging)
DELETE
FROM Duplicate_cte
WHERE row_num>1;


